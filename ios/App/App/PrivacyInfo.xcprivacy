<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This is the APP's manifest, and it describes only what this bundle does.
	     The Google Mobile Ads SDK ships its own privacy manifest and declares
	     its own collection; Apple aggregates them at submission, so do NOT copy
	     Google's declarations in here.

	     NSPrivacyTracking is FALSE here, settled by a real validator answer:
	     build 1.0.0 (6) drew ITMS-91064 "invalid tracking information" for
	     declaring true with an empty NSPrivacyTrackingDomains (Aug 20 2026).
	     The rule reads: claim tracking, name your domains — and this binary
	     makes no tracking connections of its own, so the truthful pair is
	     false + empty. Google's own GMA manifest does the same dance: it omits
	     the top-level tracking key entirely and marks DeviceID as
	     used-for-tracking at the data-type level. The user-facing "yes, this
	     app tracks" disclosure lives in the ATT prompt and the App Store
	     Connect App Privacy answers — a SEPARATE exercise, NOT derived from
	     this file; see store/listing-ios.md for the table.

	     The one required-reason API in our own binary is UserDefaults, reached
	     through @capacitor/preferences, which mirrors the local save so progress
	     survives webview data eviction. That plugin compiles into this target as
	     a Swift package and ships no manifest of its own, so it is attributed here. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read/write only this app's own defaults. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
